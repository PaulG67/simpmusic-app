# Port der Weboberflaeche. Nicht 5060 – Chrome/Edge sperren den SIP-Port (ERR_UNSAFE_PORT).
PORT=5080

# Zugangsdaten. Leer lassen – Passwort spaeter in der App unter Mehr setzen.
SUBSONIC_USER=musicplay
SUBSONIC_PASSWORD=

# Externe Basis-URL, unter der die App erreichbar ist (z.B. https://music.example.com).
# Leer lassen = wird aus der Anfrage abgeleitet.
SERVER_URL=

# Sprache/Region fuer YouTube-Music-Ergebnisse
YTM_LANGUAGE=de
YTM_LOCATION=CH

# proxy   = Audio laeuft durch den Container (empfohlen, noetig fuer Amperfy-Offline)
# redirect = Client wird direkt zu Google umgeleitet (spart Bandbreite, weniger kompatibel)
STREAM_MODE=proxy

# Abgespielte Titel auf Platte zwischenspeichern
CACHE_ENABLED=true
CACHE_MAX_GB=10

# Opus nach AAC wandeln, wenn YouTube kein m4a liefert (iOS spielt kein Opus/WebM)
TRANSCODE_TO_AAC=true

# Optional: exportierte YouTube-Music-Anmeldung, um die eigene YTM-Bibliothek zu sehen
# YTM_AUTH_FILE=/config/ytmusic_auth.json

# SponsorBlock (Intros/Outros/Werbung in Musikvideos überspringen)
SPONSORBLOCK=true

# ReturnYouTubeDislike (Like-/Dislike-Zahlen anzeigen)
RETURN_YOUTUBE_DISLIKE=true

# Songtext-Übersetzung: none | libretranslate | openai
# Für LibreTranslate z.B. TRANSLATE_URL=http://libretranslate:5000
# Für Ollama/LM Studio: TRANSLATE_PROVIDER=openai und /v1-Endpunkt
TRANSLATE_PROVIDER=none
TRANSLATE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=gpt-4o-mini
TRANSLATE_TARGET=

# Navidrome: Suche bleibt YouTube Music, Bibliothek/Downloads/Wiedergabe lokal
# NAVIDROME_URL=http://192.168.0.188:4533
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=
NAVIDROME_MUSIC_DIR=/music
NAVIDROME_IMPORT_FOLDER=YouTube

# MediaSync auf Unraid: Titel von hier zum Download uebergeben (Playlist dort waehlbar)
# MEDIASYNC_URL=http://192.168.0.188:8090
# MEDIASYNC_USER=
# MEDIASYNC_PASSWORD=

LOG_LEVEL=INFO
